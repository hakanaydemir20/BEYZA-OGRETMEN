rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Skor tablosu: herkes okuyabilir ve skor ekleyebilir.
    // Bir kayıt yalnızca daha yüksek puanla güncellenebilir.
    match /scores/{doc} {
      function valid(d) {
        return d.keys().hasOnly(['name', 'id', 'score', 't', 'demo'])
          && d.name is string && d.name.size() >= 2 && d.name.size() <= 30
          && d.id in ['a1', 'a2', 'a3', 'b1', 'b2', 'b3']
          && d.score is int && d.score >= 0 && d.score <= 2000
          && d.t is int;
      }
      allow read: if true;
      allow create: if valid(request.resource.data);
      allow update: if valid(request.resource.data)
        && !('demo' in request.resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.score > resource.data.score;
      // Yalnızca demo kayıtları silinebilir
      allow delete: if resource.data.demo == true;
    }
  }
}
